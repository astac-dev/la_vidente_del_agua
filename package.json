{
  "name": "vidente-del-agua-game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node generate-manifest.cjs && vite",
    "build": "node generate-manifest.cjs && vite build",
    "validate": "node validate-script.cjs",
    "build:itch": "node generate-manifest.cjs && vite build --base=./",
